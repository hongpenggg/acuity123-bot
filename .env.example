# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env && chmod 600 .env

# ---- required -------------------------------------------------------------

BOT_TOKEN=123456:ABC-your-botfather-token

# Local Postgres on the same VPS (recommended, see docs/SETUP.md):
DATABASE_URL=postgresql://studybot:CHANGE_ME@127.0.0.1:5432/studybot
#
# Or Supabase -> Connect -> "Session pooler" (port 5432). The direct host is
# IPv6-only and will not resolve from an IPv4-only VPS. Remember to run
# migrations/001_*.sql and 002_*.sql on it.

# Your numeric Telegram ID (message @userinfobot). Comma-separate for several.
ADMIN_IDS=111111111

# ---- optional -------------------------------------------------------------
# The whole preclinical bank ships with written explanations, so the bot runs
# with the LLM switched off. Set BOTH of these to enable generation for any
# question that has no explanation yet. Leave them blank for zero LLM spend.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

# Tuning (defaults shown; safe to omit)
BOT_TZ=Asia/Singapore
MIN_ATTEMPTS_FOR_ADAPTIVE=10
WEIGHT_FLOOR=0.15

# Where the repo is, for the GitHub links handed out when a note PDF cannot be
# sent as a file (bot/resources.py). Point these at your fork if you fork.
REPO_SLUG=hongpenggg/acuity123-bot
REPO_REF=main
