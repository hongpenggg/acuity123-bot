# Copy to .env and fill in. Never commit .env.
#   chmod 600 .env

BOT_TOKEN=123456:ABC-your-botfather-token
# Supabase -> Connect -> "Session pooler" (port 5432). The direct host is IPv6-only
# and will not resolve from an IPv4-only VPS.
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Your numeric Telegram ID (message @userinfobot). Comma-separate for several.
ADMIN_IDS=111111111

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-...
LLM_MODEL=your-chosen-model

# Optional overrides
BOT_TZ=Asia/Singapore
MIN_ATTEMPTS_FOR_ADAPTIVE=10
WEIGHT_FLOOR=0.15
