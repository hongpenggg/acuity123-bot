[Unit]
Description=LKC OphSoc Tele Bot
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

# The postgresql.service lines only matter for a local database (docs/SETUP.md).
# They are harmless if you point DATABASE_URL at Supabase: systemd ignores After=
# for a unit that doesn't exist and treats Wants= as a soft dependency.

[Service]
User=deploy
WorkingDirectory=/opt/studybot
EnvironmentFile=/opt/studybot/.env
# Give the process a usable home. asyncpg (like anything using libpq) probes
# ~/.postgresql/postgresql.key on every connect, and with ProtectHome=true that
# stat raises EACCES instead of returning "not found", which asyncpg does not
# catch - the bot crash-loops on startup. /opt/studybot is already writable via
# ReadWritePaths, so a library that wants a cache dir has somewhere to put it.
Environment=HOME=/opt/studybot
ExecStart=/opt/studybot/.venv/bin/python -m bot.main
Restart=always
RestartSec=5

# Hardening: the bot only ever talks outbound, so deny everything else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectHome is deliberately NOT set: see the HOME= note above. It is the one
# hardening option that breaks this stack.
ReadWritePaths=/opt/studybot
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
