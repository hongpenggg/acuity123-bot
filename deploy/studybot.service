[Unit]
Description=LKC OphSoc Tele Bot
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

# The postgresql.service lines only matter for a local database (docs/SETUP.md).
# They are harmless if you point DATABASE_URL at Supabase: systemd ignores After=
# for a unit that doesn't exist and treats Wants= as a soft dependency.

[Service]
User=deploy
WorkingDirectory=/opt/studybot
EnvironmentFile=/opt/studybot/.env
ExecStart=/opt/studybot/.venv/bin/python -m bot.main
Restart=always
RestartSec=5

# Hardening: the bot only ever talks outbound, so deny everything else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/studybot
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
